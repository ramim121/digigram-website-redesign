# Website environment.
#
# Copy to `.env.local` and fill in. Everything here is SERVER-ONLY on purpose —
# no NEXT_PUBLIC_ prefix, so none of it reaches the browser bundle. The browser
# talks to this site's own /api/shathi/* route handlers, and those talk to the
# backend.

# Shathi API base URL, including the /api/ path and a trailing slash.
#   test:       https://api-test.digigramventures.com/api/
#   production: https://api.digigramventures.com/api/
SHATHI_API_URL=https://api-test.digigramventures.com/api/

# Public S3 origin serving project / partner / blog images.
SHATHI_S3_URL=https://saathi-files-new.s3.ap-southeast-1.amazonaws.com/

# Seconds a cached backend response stays fresh. User-specific calls ignore this
# and are never cached.
SHATHI_REVALIDATE=300

# Backend call timeout in milliseconds. On expiry the page renders seed content
# with the "cached information" notice rather than failing.
SHATHI_TIMEOUT_MS=8000

# GA4 measurement id. Analytics is disabled outside production regardless.
NEXT_PUBLIC_GA_ID=G-JLQYQDN2RZ

# Canonical site origin, used for absolute URLs in metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://digigramventures.com

# Google sign-in.
# A client ID is a public identifier, not a secret — it is visible in any
# OAuth flow — so it carries NEXT_PUBLIC_ and is compiled into the browser
# bundle. It must match GOOGLE_CLIENT_ID on the API, which verifies the
# returned token against the same audience. Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1055024852778-23tb7da8pka2vnatqiej8emuv2t01qem.apps.googleusercontent.com
